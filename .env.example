# --- LLM / tools ---
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- API conversacional ---
# Mesma URL usada pelo docker-compose.yml (porta 5433 no host).
DATABASE_URL=postgresql://sales:sales@localhost:5433/sales_assistant
API_HOST=127.0.0.1
API_PORT=8000
# Origens liberadas no CORS (lista JSON).
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Servidor MCP de e-mail (opcional — a API sobe sem ele).
MAIL_SERVER_URL=http://127.0.0.1:5002/mcp
# Se true, o streaming também emite os tokens dos subagents.
STREAM_SUBAGENT_TOKENS=false
